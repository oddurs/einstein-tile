---
// Scene 3 — try to break it. Sprint ticket S2, docs/09.
const title = 'Try to make it repeat';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta
      name="description"
      content="Lay einstein tiles by hand and try to make the pattern repeat. You can't — and that's the point."
    />
  </head>
  <body>
    <main data-placement>
      <canvas data-canvas></canvas>

      <div class="hud">
        <p data-prompt class="prompt"></p>
        <div class="row">
          <button data-undo type="button">Undo</button>
          <button data-reset type="button">Start over</button>
          <span data-count class="count"></span>
        </div>
      </div>
    </main>

    <script>
      import { mountPlacementScene } from '../scenes/placement.js';
      const root = document.querySelector<HTMLElement>('[data-placement]');
      if (root) mountPlacementScene(root);
    </script>

    <style>
      /* Surfaces match palette.ts SURFACE. */
      :root {
        --bg: #fcfcfb;
        --fg: #1a1a19;
        --panel: rgba(252, 252, 251, 0.9);
        --line: rgba(26, 26, 25, 0.16);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #1a1a19;
          --fg: #f0efec;
          --panel: rgba(26, 26, 25, 0.9);
          --line: rgba(240, 239, 236, 0.18);
        }
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        height: 100dvh;
        overflow: hidden;
        background: var(--bg);
        color: var(--fg);
        font: 400 16px/1.5 ui-serif, Georgia, 'Times New Roman', serif;
        -webkit-text-size-adjust: 100%;
      }

      main { position: relative; height: 100%; }

      canvas {
        display: block;
        width: 100%;
        height: 100%;
        touch-action: none;
      }

      .hud {
        position: absolute;
        left: max(14px, env(safe-area-inset-left));
        right: max(14px, env(safe-area-inset-right));
        bottom: max(14px, env(safe-area-inset-bottom));
        padding: 16px 18px;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--panel);
        backdrop-filter: blur(14px);
      }
      @media (min-width: 720px) {
        .hud { right: auto; max-width: 30rem; }
      }

      .prompt {
        margin: 0 0 14px;
        font-size: clamp(17px, 4.2vw, 20px);
        line-height: 1.35;
        text-wrap: balance;
        min-height: 2.7em; /* reserve space so the panel doesn't jump */
      }

      .row { display: flex; align-items: center; gap: 10px; }

      button {
        min-height: 44px; /* touch target floor, docs/06 §4 */
        padding: 0 16px;
        border: 1px solid var(--line);
        border-radius: 9px;
        background: transparent;
        color: inherit;
        font: inherit;
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 14px;
      }
      button:disabled { opacity: 0.4; }

      .count {
        margin-left: auto;
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 13px;
        font-variant-numeric: tabular-nums;
        opacity: 0.6;
      }

      @media (prefers-reduced-motion: reduce) {
        * { transition: none !important; animation: none !important; }
      }
    </style>
  </body>
</html>
