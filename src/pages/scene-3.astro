---
// Scene 3 — slide it over itself. Sprint ticket S2 (redesigned), docs/09.
const title = 'Try to make it repeat';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta
      name="description"
      content="Slide a copy of the pattern over itself. A hexagon floor clicks into place. The einstein tiling never does."
    />
  </head>
  <body>
    <main data-repeat>
      <canvas data-canvas></canvas>

      <div class="hud">
        <h1 data-title class="title"></h1>
        <p data-prompt class="prompt"></p>

        <div class="gauge">
          <div class="track"><div data-bar class="bar"></div></div>
          <span data-meter class="meter"></span>
        </div>

        <div class="row">
          <button data-next type="button" hidden></button>
          <button data-reset type="button">Show me the best there is</button>
        </div>
      </div>
    </main>

    <script>
      import { mountRepeatScene } from '../scenes/repeat.js';
      const root = document.querySelector<HTMLElement>('[data-repeat]');
      if (root) mountRepeatScene(root);
    </script>

    <style>
      /* Surfaces match palette.ts SURFACE. */
      :root {
        --bg: #fcfcfb;
        --fg: #1a1a19;
        --panel: rgba(252, 252, 251, 0.92);
        --line: rgba(26, 26, 25, 0.16);
        --accent: #3eb4f1;
        --good: #1f9d55;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #1a1a19;
          --fg: #f0efec;
          --panel: rgba(26, 26, 25, 0.92);
          --line: rgba(240, 239, 236, 0.18);
          --accent: #0e97d2;
          --good: #35b26a;
        }
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        height: 100dvh;
        overflow: hidden;
        background: var(--bg);
        color: var(--fg);
        font: 400 16px/1.5 ui-serif, Georgia, 'Times New Roman', serif;
        -webkit-text-size-adjust: 100%;
      }

      main { position: relative; height: 100%; }

      canvas {
        display: block;
        width: 100%;
        height: 100%;
        touch-action: none;
        cursor: grab;
      }
      canvas:active { cursor: grabbing; }

      .hud {
        position: absolute;
        left: max(14px, env(safe-area-inset-left));
        right: max(14px, env(safe-area-inset-right));
        bottom: max(14px, env(safe-area-inset-bottom));
        padding: 16px 18px;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--panel);
        backdrop-filter: blur(14px);
      }
      @media (min-width: 720px) {
        .hud { right: auto; max-width: 31rem; }
      }

      .title {
        margin: 0 0 6px;
        font-size: 13px;
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-weight: 500;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        opacity: 0.55;
      }

      .prompt {
        margin: 0 0 14px;
        font-size: clamp(17px, 4.2vw, 20px);
        line-height: 1.35;
        text-wrap: balance;
        min-height: 2.7em;
      }

      .gauge {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
      }

      .track {
        flex: 1;
        height: 8px;
        border-radius: 999px;
        background: color-mix(in oklab, var(--fg) 12%, transparent);
        overflow: hidden;
      }

      .bar {
        height: 100%;
        width: 0;
        border-radius: 999px;
        background: var(--accent);
        transition: width 90ms linear;
      }
      .bar[data-perfect='true'] { background: var(--good); }

      .meter {
        flex: 0 0 auto;
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 12.5px;
        font-variant-numeric: tabular-nums;
        opacity: 0.65;
      }

      .row { display: flex; gap: 10px; }

      button {
        min-height: 44px; /* touch target floor, docs/06 §4 */
        padding: 0 16px;
        border: 1px solid var(--line);
        border-radius: 9px;
        background: transparent;
        color: inherit;
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 14px;
      }
      button[data-next]:not([hidden]) {
        border-color: transparent;
        background: var(--fg);
        color: var(--bg);
      }

      @media (prefers-reduced-motion: reduce) {
        * { transition: none !important; animation: none !important; }
      }
    </style>
  </body>
</html>
